# npm resolves only versions published at least 7 days ago, so a relock
# (Renovate's lock file maintenance, or an `npm install` here) never pulls
# a release too new for anyone to have caught a compromise. Renovate waits
# the same 7 days before it proposes a bump. A security fix younger than
# that resolves only once its package is listed here as
# `min-release-age-exclude[]=<name>`; remove the line once it has aged.
min-release-age=7
